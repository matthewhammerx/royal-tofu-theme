{%- doc -%}
  Compact add-on upsell shown under the add to cart button.
  Adds the selected product to the cart on its own (independent of the main product form / Kaching bundles),
  at the product's regular Shopify price.
{%- enddoc -%}

{%- liquid
  assign upsell = block.settings.product
  assign variant = upsell.selected_or_first_available_variant
  assign show_variant_picker = false
  if block.settings.show_variant_picker and upsell.has_only_default_variant == false
    assign show_variant_picker = true
  endif
-%}

{%- if upsell != blank -%}
  {%- unless upsell.id == closest.product.id -%}
    <script src="{{ 'product-upsell.js' | asset_url }}" type="module" fetchpriority="low"></script>

    <product-upsell-component
      class="product-upsell spacing-style"
      style="
        {% render 'spacing-style', settings: block.settings %}
        --upsell-bg: {{ block.settings.background_color }};
        --upsell-border: {{ block.settings.border_color }};
        --upsell-accent: {{ block.settings.accent_color }};
        --upsell-radius: {{ block.settings.border_radius }}px;
        --upsell-image-size: {{ block.settings.image_size }}px;
      "
      data-open-cart="{{ block.settings.open_cart_drawer }}"
      {{ block.shopify_attributes }}
    >
      {%- if block.settings.heading != blank -%}
        <p class="product-upsell__heading">{{ block.settings.heading }}</p>
      {%- endif -%}

      <div class="product-upsell__card">
        {%- if block.settings.badge != blank -%}
          <span class="product-upsell__badge">{{ block.settings.badge }}</span>
        {%- endif -%}

        {%- assign image = variant.featured_image | default: upsell.featured_image -%}
        {%- if image != blank -%}
          <a class="product-upsell__media" href="{{ upsell.url }}" tabindex="-1" aria-hidden="true">
            {{
              image
              | image_url: width: 200
              | image_tag:
                loading: 'lazy',
                width: block.settings.image_size,
                height: block.settings.image_size,
                alt: image.alt,
                ref: 'image'
            }}
          </a>
        {%- endif -%}

        <div class="product-upsell__info">
          <a class="product-upsell__title" href="{{ upsell.url }}">{{ upsell.title }}</a>
          {%- if block.settings.subtitle != blank -%}
            <p class="product-upsell__subtitle">{{ block.settings.subtitle }}</p>
          {%- endif -%}

          {%- if show_variant_picker -%}
            <select
              class="product-upsell__select"
              aria-label="{{ upsell.options | join: ' / ' | escape }}"
              ref="variantSelect"
            >
              {%- for v in upsell.variants -%}
                <option
                  value="{{ v.id }}"
                  data-price="{{ v.price | money | escape }}"
                  data-compare="{% if v.compare_at_price > v.price %}{{ v.compare_at_price | money | escape }}{% endif %}"
                  data-image="{% if v.featured_image %}{{ v.featured_image | image_url: width: 200 }}{% endif %}"
                  {% if v.id == variant.id %}
                    selected
                  {% endif %}
                  {% unless v.available %}
                    disabled
                  {% endunless %}
                >
                  {{ v.title }}
                </option>
              {%- endfor -%}
            </select>
          {%- endif -%}
        </div>

        <div class="product-upsell__side">
          <div class="product-upsell__prices">
            <span class="product-upsell__price" ref="price">{{ variant.price | money }}</span>
            <s class="product-upsell__compare{% unless variant.compare_at_price > variant.price and block.settings.show_compare_price %} hidden{% endunless %}" ref="compare">
              {%- if variant.compare_at_price > variant.price -%}{{ variant.compare_at_price | money }}{%- endif -%}
            </s>
          </div>

          <button
            type="button"
            class="product-upsell__button"
            data-variant-id="{{ variant.id }}"
            data-label="{{ block.settings.button_label | escape }}"
            data-added-label="{{ block.settings.added_label | escape }}"
            data-sold-out-label="{{ block.settings.sold_out_label | escape }}"
            ref="button"
            {% unless variant.available %}
              disabled
            {% endunless %}
          >
            {%- if variant.available -%}
              {{ block.settings.button_label }}
            {%- else -%}
              {{ block.settings.sold_out_label }}
            {%- endif -%}
          </button>
        </div>
      </div>

      <p class="product-upsell__error hidden" role="alert" ref="error"></p>
    </product-upsell-component>
  {%- endunless -%}
{%- elsif request.design_mode -%}
  <div class="product-upsell product-upsell--placeholder" {{ block.shopify_attributes }}>
    Upsell : choisissez un produit dans les paramètres du bloc.
  </div>
{%- endif -%}

{% stylesheet %}
  .product-upsell {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
  }

  .product-upsell__heading {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .product-upsell__card {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    background: var(--upsell-bg);
    border: 1px solid var(--upsell-border);
    border-radius: var(--upsell-radius);
  }

  .product-upsell__badge {
    position: absolute;
    top: -9px;
    right: 12px;
    padding: 2px 8px;
    font-size: 0.6875rem;
    font-weight: 700;
    line-height: 1.4;
    text-transform: uppercase;
    color: #000;
    background: var(--upsell-accent);
    border-radius: 3px;
  }

  .product-upsell__media {
    flex: 0 0 var(--upsell-image-size);
    width: var(--upsell-image-size);
    height: var(--upsell-image-size);
    overflow: hidden;
    border-radius: calc(var(--upsell-radius) / 2);
  }

  .product-upsell__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-upsell__info {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .product-upsell__title {
    font-weight: 700;
    line-height: 1.2;
    color: inherit;
    text-decoration: none;
  }

  .product-upsell__subtitle {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.3;
    color: var(--color-foreground-muted, rgb(var(--color-foreground-rgb) / 0.7));
  }

  .product-upsell__select {
    width: fit-content;
    max-width: 100%;
    margin-top: 4px;
    padding: 4px 8px;
    font: inherit;
    font-size: 0.8125rem;
    color: inherit;
    background: var(--color-background);
    border: 1px solid var(--upsell-border);
    border-radius: 4px;
  }

  .product-upsell__side {
    display: flex;
    flex: 0 0 auto;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
  }

  .product-upsell__prices {
    display: flex;
    align-items: baseline;
    gap: 6px;
    line-height: 1.2;
  }

  .product-upsell__price {
    font-weight: 700;
  }

  .product-upsell__compare {
    font-size: 0.8125rem;
    color: var(--color-foreground-muted, rgb(var(--color-foreground-rgb) / 0.6));
  }

  .product-upsell__button {
    padding: 6px 14px;
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.2;
    white-space: nowrap;
    color: #000;
    background: var(--upsell-accent);
    border: 0;
    border-radius: 999px;
    cursor: pointer;
    transition: opacity 0.15s ease;
  }

  .product-upsell__button:hover:not(:disabled) {
    opacity: 0.85;
  }

  .product-upsell__button:disabled {
    cursor: default;
    opacity: 0.6;
  }

  .product-upsell__button[aria-busy='true'] {
    cursor: progress;
    opacity: 0.6;
  }

  .product-upsell__button.is-added {
    color: #fff;
    background: #2e7d32;
    opacity: 1;
  }

  .product-upsell__error {
    margin: 0;
    font-size: 0.8125rem;
    color: #c62828;
  }

  .product-upsell--placeholder {
    padding: 12px;
    font-size: 0.8125rem;
    border: 1px dashed currentColor;
    border-radius: 8px;
    opacity: 0.7;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Upsell add-on",
  "tag": null,
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Sold at its regular Shopify price. Set a compare-at price on the product to show a strikethrough."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Complétez votre commande"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Pelle en métal robuste, tamise les grumeaux en un geste"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "info": "Leave empty to hide."
    },
    {
      "type": "checkbox",
      "id": "show_compare_price",
      "label": "Show compare-at price",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_variant_picker",
      "label": "Show variant picker",
      "info": "Only when the product has multiple variants.",
      "default": true
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Label",
      "default": "+ Ajouter"
    },
    {
      "type": "text",
      "id": "added_label",
      "label": "Added label",
      "default": "✓ Ajouté"
    },
    {
      "type": "text",
      "id": "sold_out_label",
      "label": "Sold out label",
      "default": "Épuisé"
    },
    {
      "type": "checkbox",
      "id": "open_cart_drawer",
      "label": "Open cart drawer after adding",
      "info": "Off keeps the shopper on the product page.",
      "default": false
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#f3e3a6"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Button and badge",
      "default": "#f2b705"
    },
    {
      "type": "range",
      "id": "image_size",
      "label": "Image size",
      "min": 36,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Upsell add-on",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
