{%- doc -%}
  Kaching-style add-on row with an on/off switch, shown near the add to cart button.
  Switching it on adds the product to the cart, switching it off removes it.
  Independent of the main product form / Kaching bundles: sold at the product's regular Shopify price.
{%- enddoc -%}

{%- liquid
  assign upsell = block.settings.product
  assign variant = upsell.selected_or_first_available_variant
  assign show_variant_picker = false
  if block.settings.show_variant_picker and upsell.has_only_default_variant == false
    assign show_variant_picker = true
  endif
  assign switch_id = 'ProductUpsell-' | append: block.id
-%}

{%- if block.settings.hide_kaching_upsells -%}
  <style>
    .kaching-bundles .kaching-bundles__checkbox-upsells,
    .kaching-bundles .kaching-bundles__upsell {
      display: none !important;
    }
  </style>
{%- endif -%}

{%- if upsell != blank -%}
  {%- comment -%} `closest.product` would resolve to this block's own product setting, so compare with the page product {%- endcomment -%}
  {%- unless upsell.id == product.id -%}
    <script src="{{ 'product-upsell.js' | asset_url }}" type="module" fetchpriority="low"></script>

    <product-upsell-component
      class="product-upsell spacing-style{% unless variant.available %} is-disabled{% endunless %}"
      style="
        {% render 'spacing-style', settings: block.settings %}
        --upsell-bg: {{ block.settings.background_color }};
        --upsell-bg-active: {{ block.settings.active_background_color }};
        --upsell-border: {{ block.settings.border_color }};
        --upsell-accent: {{ block.settings.accent_color }};
        --upsell-radius: {{ block.settings.border_radius }}px;
        --upsell-image-size: {{ block.settings.image_size }}px;
      "
      data-variant-id="{{ variant.id }}"
      data-open-cart="{{ block.settings.open_cart_drawer }}"
      {{ block.shopify_attributes }}
    >
      {%- if block.settings.heading != blank -%}
        <p class="product-upsell__heading">{{ block.settings.heading }}</p>
      {%- endif -%}

      <div class="product-upsell__card" ref="card">
        {%- if block.settings.badge != blank -%}
          <span class="product-upsell__badge">{{ block.settings.badge }}</span>
        {%- endif -%}

        <button
          type="button"
          id="{{ switch_id }}"
          class="product-upsell__switch"
          role="switch"
          aria-checked="false"
          aria-labelledby="{{ switch_id }}-title"
          ref="switch"
          {% unless variant.available %}
            disabled
          {% endunless %}
        >
          <span class="product-upsell__knob"></span>
        </button>

        {%- assign image = variant.featured_image | default: upsell.featured_image -%}
        {%- if image != blank -%}
          <span class="product-upsell__media">
            {{
              image
              | image_url: width: 200
              | image_tag:
                loading: 'lazy',
                width: block.settings.image_size,
                height: block.settings.image_size,
                alt: image.alt,
                ref: 'image'
            }}
          </span>
        {%- endif -%}

        <div class="product-upsell__info">
          <span class="product-upsell__title" id="{{ switch_id }}-title">{{ upsell.title }}</span>
          <span class="product-upsell__subtitle{% if block.settings.subtitle == blank and variant.available %} hidden{% endif %}"
            ref="subtitle"
            data-subtitle="{{ block.settings.subtitle | escape }}"
            data-sold-out="{{ block.settings.sold_out_label | escape }}"
          >
            {%- if variant.available -%}
              {{ block.settings.subtitle }}
            {%- else -%}
              {{ block.settings.sold_out_label }}
            {%- endif -%}
          </span>

          {%- if show_variant_picker -%}
            <select
              class="product-upsell__select"
              aria-label="{{ upsell.options | join: ' / ' | escape }}"
              ref="variantSelect"
            >
              {%- for v in upsell.variants -%}
                <option
                  value="{{ v.id }}"
                  data-price="{{ v.price | money | escape }}"
                  data-compare="{% if v.compare_at_price > v.price %}{{ v.compare_at_price | money | escape }}{% endif %}"
                  data-image="{% if v.featured_image %}{{ v.featured_image | image_url: width: 200 }}{% endif %}"
                  {% if v.id == variant.id %}
                    selected
                  {% endif %}
                  {% unless v.available %}
                    disabled
                  {% endunless %}
                >
                  {{ v.title }}
                </option>
              {%- endfor -%}
            </select>
          {%- endif -%}
        </div>

        <div class="product-upsell__prices">
          <span class="product-upsell__price" ref="price">{{ variant.price | money }}</span>
          <s class="product-upsell__compare{% unless variant.compare_at_price > variant.price and block.settings.show_compare_price %} hidden{% endunless %}" ref="compare">
            {%- if variant.compare_at_price > variant.price -%}{{ variant.compare_at_price | money }}{%- endif -%}
          </s>
        </div>
      </div>

      <p class="product-upsell__error hidden" role="alert" ref="error"></p>
    </product-upsell-component>
  {%- endunless -%}
{%- elsif request.design_mode -%}
  <div class="product-upsell product-upsell--placeholder" {{ block.shopify_attributes }}>
    Upsell : choisissez un produit dans les paramètres du bloc.
  </div>
{%- endif -%}

{% stylesheet %}
  .product-upsell {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
  }

  .product-upsell__heading {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .product-upsell__card {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 18px;
    background: var(--upsell-bg);
    border: 1px solid var(--upsell-border);
    border-radius: var(--upsell-radius);
    cursor: pointer;
    transition: background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .product-upsell.is-active .product-upsell__card {
    background: var(--upsell-bg-active);
    border-color: var(--upsell-accent);
    box-shadow: inset 0 0 0 1px var(--upsell-accent);
  }

  .product-upsell.is-disabled .product-upsell__card {
    cursor: default;
    opacity: 0.6;
  }

  .product-upsell__badge {
    position: absolute;
    top: -10px;
    right: 14px;
    padding: 2px 8px;
    font-size: 0.6875rem;
    font-weight: 700;
    line-height: 1.4;
    text-transform: uppercase;
    color: #000;
    background: var(--upsell-accent);
    border-radius: 3px;
  }

  .product-upsell__switch {
    position: relative;
    flex: 0 0 auto;
    width: 42px;
    height: 24px;
    padding: 0;
    background: #d9d9d9;
    border: 0;
    border-radius: 999px;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .product-upsell__switch:focus-visible {
    outline: 2px solid var(--upsell-accent);
    outline-offset: 2px;
  }

  .product-upsell__switch[aria-checked='true'] {
    background: var(--upsell-accent);
  }

  .product-upsell__switch:disabled {
    cursor: default;
  }

  .product-upsell__switch[aria-busy='true'] {
    cursor: progress;
    opacity: 0.7;
  }

  .product-upsell__knob {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 18px;
    height: 18px;
    background: #fff;
    border-radius: 50%;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.25);
    transition: transform 0.2s ease;
  }

  .product-upsell__switch[aria-checked='true'] .product-upsell__knob {
    transform: translateX(18px);
  }

  .product-upsell__media {
    flex: 0 0 var(--upsell-image-size);
    width: var(--upsell-image-size);
    height: var(--upsell-image-size);
    overflow: hidden;
    border-radius: 4px;
  }

  .product-upsell__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-upsell__info {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .product-upsell__title {
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .product-upsell__subtitle {
    font-size: 0.8125rem;
    line-height: 1.3;
    color: var(--color-foreground-muted, rgb(var(--color-foreground-rgb) / 0.7));
  }

  .product-upsell__select {
    width: fit-content;
    max-width: 100%;
    margin-top: 4px;
    padding: 4px 8px;
    font: inherit;
    font-size: 0.8125rem;
    color: inherit;
    background: #fff;
    border: 1px solid var(--upsell-border);
    border-radius: 4px;
    cursor: pointer;
  }

  .product-upsell__prices {
    display: flex;
    flex: 0 0 auto;
    flex-direction: column;
    align-items: flex-end;
    line-height: 1.2;
  }

  .product-upsell__price {
    font-size: 1.125rem;
    font-weight: 700;
  }

  .product-upsell__compare {
    font-size: 0.875rem;
    color: var(--color-foreground-muted, rgb(var(--color-foreground-rgb) / 0.6));
  }

  .product-upsell__error {
    margin: 0;
    font-size: 0.8125rem;
    color: #c62828;
  }

  .product-upsell--placeholder {
    padding: 12px;
    font-size: 0.8125rem;
    border: 1px dashed currentColor;
    border-radius: 8px;
    opacity: 0.7;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Upsell add-on",
  "tag": null,
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Sold at its regular Shopify price. Set a compare-at price on the product to show a strikethrough."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave empty to hide."
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Pelle en métal robuste, tamise les grumeaux en un geste"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "info": "Leave empty to hide."
    },
    {
      "type": "checkbox",
      "id": "show_compare_price",
      "label": "Show compare-at price",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_variant_picker",
      "label": "Show variant picker",
      "info": "Only when the product has multiple variants.",
      "default": true
    },
    {
      "type": "text",
      "id": "sold_out_label",
      "label": "Sold out label",
      "default": "Épuisé"
    },
    {
      "type": "checkbox",
      "id": "open_cart_drawer",
      "label": "Open cart drawer when switched on",
      "info": "Off keeps the shopper on the product page.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_kaching_upsells",
      "label": "Hide Kaching upsells",
      "info": "Hides Kaching's own add-on rows so this block replaces them. Make sure none of them is pre-selected in Kaching, or it would still be added to the cart.",
      "default": true
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "active_background_color",
      "label": "Background when on",
      "default": "#fdf3dc"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#f3e3a6"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Switch, badge and border when on",
      "default": "#f2b705"
    },
    {
      "type": "range",
      "id": "image_size",
      "label": "Image size",
      "min": 36,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Upsell add-on",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
