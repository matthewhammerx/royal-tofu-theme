      "min": 16,
      "max": 90,
      "step": 2,
      "unit": "px",
      "default": 42
    },
    {
      "type": "range",
      "id": "card_gap_desktop",
      "label": "Desktop card gap",
      "min": 8,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "image_height_desktop",
      "label": "Desktop image height",
      "min": 180,
      "max": 520,
      "step": 10,
      "unit": "px",
      "default": 320
    },
    {
      "type": "range",
      "id": "card_padding_desktop",
