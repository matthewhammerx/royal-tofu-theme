{% comment %}
  Royal Tofu - Infinite Scent Carousel
{% endcomment %}

<section id="rt-scents-{{ section.id }}" class="rt-scents">
  <div class="rt-scents__inner">
    {% if section.settings.heading != blank %}
      <div class="rt-scents__header">
        <p class="rt-scents__eyebrow">{{ section.settings.eyebrow }}</p>
        <h2>{{ section.settings.heading }}</h2>
        {% if section.settings.text != blank %}
          <p class="rt-scents__text">{{ section.settings.text }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="rt-scents__carousel" aria-label="Royal Tofu scent carousel">
      <div class="rt-scents__track">
        <div class="rt-scents__group">
          {% for block in section.blocks %}
            <div class="rt-scents__card" {{ block.shopify_attributes }}>
              <div class="rt-scents__image-wrap">
                {% if block.settings.image != blank %}
                  <img
                    src="{{ block.settings.image | image_url: width: 900 }}"
                    alt="{{ block.settings.scent_name | escape }}"
                    loading="lazy"
                    class="rt-scents__image"
                  >
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'rt-scents__placeholder' }}
                {% endif %}

                {% if block.settings.scent_name != blank %}
                  <div class="rt-scents__pill">
                    {{ block.settings.scent_name }}
                  </div>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>

        <div class="rt-scents__group" aria-hidden="true">
          {% for block in section.blocks %}
            <div class="rt-scents__card">
              <div class="rt-scents__image-wrap">
                {% if block.settings.image != blank %}
                  <img
                    src="{{ block.settings.image | image_url: width: 900 }}"
                    alt=""
                    loading="lazy"
                    class="rt-scents__image"
                  >
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'rt-scents__placeholder' }}
                {% endif %}

                {% if block.settings.scent_name != blank %}
                  <div class="rt-scents__pill">
                    {{ block.settings.scent_name }}
                  </div>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>

    {% if section.settings.button_label != blank %}
      <div class="rt-scents__button-wrap">
        {% assign rt_button_link = section.settings.button_link | default: '#buy-section' %}
{% assign rt_button_first_char = rt_button_link | slice: 0, 1 %}

<a
  href="{{ rt_button_link }}"
  class="rt-scents__button"
  {% if rt_button_first_char == '#' %}
    data-rt-buy-button
    data-target="{{ rt_button_link }}"
  {% endif %}
>
  {{ section.settings.button_label }}
</a>
      </div>
    {% endif %}
  </div>
</section>

<style>
  #rt-scents-{{ section.id }} {
    --rt-bg: {{ section.settings.background }};
    --rt-text: {{ section.settings.text_color }};
    --rt-pill-bg: {{ section.settings.pill_bg }};
    --rt-pill-text: {{ section.settings.pill_text }};
    --rt-button-bg: {{ section.settings.button_bg }};
    --rt-button-text: {{ section.settings.button_text }};
    --rt-speed: {{ section.settings.speed }}s;

    background: var(--rt-bg);
    color: var(--rt-text);
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    overflow: hidden;
  }

  #rt-scents-{{ section.id }} .rt-scents__inner {
    width: 100%;
  }

  #rt-scents-{{ section.id }} .rt-scents__header {
    max-width: 760px;
    margin: 0 auto 28px;
    padding: 0 18px;
    text-align: center;
  }

  #rt-scents-{{ section.id }} .rt-scents__eyebrow {
    margin: 0 0 8px;
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.75;
    font-weight: 700;
  }

  #rt-scents-{{ section.id }} h2 {
    margin: 0;
    font-size: clamp(30px, 4vw, 54px);
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--rt-text);
  }

  #rt-scents-{{ section.id }} .rt-scents__text {
    max-width: 560px;
    margin: 14px auto 0;
    font-size: 16px;
    line-height: 1.5;
    opacity: 0.78;
  }

  #rt-scents-{{ section.id }} .rt-scents__carousel {
    position: relative;
    width: 100%;
    overflow: hidden;
    padding: 6px 0;
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 8%, #000 92%, transparent 100%);
    mask-image: linear-gradient(to right, transparent 0%, #000 8%, #000 92%, transparent 100%);
  }

  #rt-scents-{{ section.id }} .rt-scents__track {
    display: flex;
    width: max-content;
    animation: rtScentsScroll-{{ section.id }} var(--rt-speed) linear infinite;
  }

  #rt-scents-{{ section.id }} .rt-scents__carousel:hover .rt-scents__track {
    animation-play-state: paused;
  }

  #rt-scents-{{ section.id }} .rt-scents__group {
    display: flex;
    gap: {{ section.settings.gap }}px;
    padding-right: {{ section.settings.gap }}px;
  }

  #rt-scents-{{ section.id }} .rt-scents__card {
    width: {{ section.settings.card_width }}px;
    flex: 0 0 {{ section.settings.card_width }}px;
  }

  #rt-scents-{{ section.id }} .rt-scents__image-wrap {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: {{ section.settings.radius }}px;
    background: rgba(255,255,255,0.4);
    box-shadow: 0 12px 34px rgba(0,0,0,0.08);
  }

  #rt-scents-{{ section.id }} .rt-scents__image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 0.45s ease;
  }

  #rt-scents-{{ section.id }} .rt-scents__card:hover .rt-scents__image {
    transform: scale(1.04);
  }

  #rt-scents-{{ section.id }} .rt-scents__placeholder {
    width: 100%;
    height: 100%;
    display: block;
    background: #f7efe6;
  }

  #rt-scents-{{ section.id }} .rt-scents__pill {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 2;
    padding: 8px 14px;
    border-radius: 999px;
    background: var(--rt-pill-bg);
    color: var(--rt-pill-text);
    font-size: 13px;
    font-weight: 800;
    line-height: 1;
    box-shadow: 0 8px 20px rgba(0,0,0,0.12);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  #rt-scents-{{ section.id }} .rt-scents__button-wrap {
    display: flex;
    justify-content: center;
    margin-top: 30px;
    padding: 0 18px;
  }

  #rt-scents-{{ section.id }} .rt-scents__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 54px;
    padding: 0 34px;
    border-radius: 999px;
    background: var(--rt-button-bg);
    color: var(--rt-button-text);
    text-decoration: none;
    font-size: 16px;
    font-weight: 800;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  #rt-scents-{{ section.id }} .rt-scents__button:hover {
    transform: translateY(-2px);
    opacity: 0.9;
  }

  @keyframes rtScentsScroll-{{ section.id }} {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @media screen and (max-width: 749px) {
    #rt-scents-{{ section.id }} {
      padding: {{ section.settings.mobile_padding_top }}px 0 {{ section.settings.mobile_padding_bottom }}px;
    }

    #rt-scents-{{ section.id }} .rt-scents__header {
      margin-bottom: 20px;
    }

    #rt-scents-{{ section.id }} h2 {
      font-size: clamp(28px, 9vw, 42px);
    }

    #rt-scents-{{ section.id }} .rt-scents__text {
      font-size: 15px;
    }

    #rt-scents-{{ section.id }} .rt-scents__card {
      width: {{ section.settings.mobile_card_width }}px;
      flex-basis: {{ section.settings.mobile_card_width }}px;
    }

    #rt-scents-{{ section.id }} .rt-scents__pill {
      top: 10px;
      right: 10px;
      font-size: 12px;
      padding: 7px 12px;
    }

    #rt-scents-{{ section.id }} .rt-scents__button {
      width: 100%;
      max-width: 360px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #rt-scents-{{ section.id }} .rt-scents__track {
      animation: none;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var section = document.getElementById('rt-scents-{{ section.id }}');
    if (!section) return;

    var button = section.querySelector('[data-rt-buy-button]');
    if (!button) return;

    button.addEventListener('click', function (event) {
      var target = button.getAttribute('data-target') || '#buy-section';

      if (!target || target.charAt(0) !== '#') return;

      event.preventDefault();

      var targetElement = null;

      try {
        targetElement = document.querySelector(target);
      } catch (e) {}

      if (!targetElement) {
        targetElement = document.querySelector('product-form, .product-form, form[action*="/cart/add"], [id^="ProductSubmitButton"]');
      }

      if (targetElement) {
        targetElement.scrollIntoView({
          behavior: 'smooth',
          block: 'center'
        });
      }
    });
  });
</script>

{% schema %}
{
  "name": "Royal Tofu Scents",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small top text",
      "default": "Available scents"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Choose your cat’s favorite scent"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Explore Royal Tofu’s fresh, clean scents made to keep your litter routine simple and pleasant."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Royal Tofu"
    },
    {
  "type": "url",
  "id": "button_link",
  "label": "Button link"
},
    {
      "type": "range",
      "id": "speed",
      "label": "Carousel speed",
      "min": 12,
      "max": 80,
      "step": 2,
      "unit": "s",
      "default": 34
    },
    {
      "type": "range",
      "id": "card_width",
      "label": "Desktop card width",
      "min": 180,
      "max": 420,
      "step": 10,
      "unit": "px",
      "default": 300
    },
    {
      "type": "range",
      "id": "mobile_card_width",
      "label": "Mobile card width",
      "min": 160,
      "max": 320,
      "step": 10,
      "unit": "px",
      "default": 230
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Image gap",
      "min": 8,
      "max": 36,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#FFF7EF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#2A211B"
    },
    {
      "type": "color",
      "id": "pill_bg",
      "label": "Pill background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "pill_text",
      "label": "Pill text",
      "default": "#2A211B"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background",
      "default": "#2A211B"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button text",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Desktop padding top",
      "min": 20,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Desktop padding bottom",
      "min": 20,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile padding top",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile padding bottom",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "scent",
      "name": "Scent",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Scent image"
        },
        {
          "type": "text",
          "id": "scent_name",
          "label": "Scent name",
          "default": "Lavender"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Royal Tofu Scents",
      "blocks": [
        {
          "type": "scent",
          "settings": {
            "scent_name": "Lavender"
          }
        },
        {
          "type": "scent",
          "settings": {
            "scent_name": "Green Tea"
          }
        },
        {
          "type": "scent",
          "settings": {
            "scent_name": "Peach"
          }
        },
        {
          "type": "scent",
          "settings": {
            "scent_name": "Original"
          }
        }
      ]
    }
  ]
}
{% endschema %}