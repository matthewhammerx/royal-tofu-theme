{%- comment -%}
  Grid of numbered (or icon) cards: "how to use" steps, specs, signs to watch for, etc.
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} .rt-steps {
    padding: {{ section.settings.mobile_padding_top }}px 16px {{ section.settings.mobile_padding_bottom }}px;
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
  }

  #shopify-section-{{ section.id }} .rt-steps__inner {
    max-width: {{ section.settings.section_width }}px;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .rt-steps__intro {
    max-width: 720px;
    margin: 0 auto 32px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .rt-steps__eyebrow {
    margin: 0 0 10px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: {{ section.settings.accent_color }};
  }

  #shopify-section-{{ section.id }} .rt-steps__heading {
    margin: 0;
    font-size: {{ section.settings.mobile_heading_size }}px;
    line-height: 1.1;
    color: {{ section.settings.heading_color }};
  }

  #shopify-section-{{ section.id }} .rt-steps__text {
    margin-top: 14px;
    font-size: 16px;
    line-height: 1.6;
  }

  #shopify-section-{{ section.id }} .rt-steps__text p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .rt-steps__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #shopify-section-{{ section.id }} .rt-steps__card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px;
    background: {{ section.settings.card_background }};
    border: 1px solid {{ section.settings.card_border }};
    border-radius: {{ section.settings.radius }}px;
  }

  #shopify-section-{{ section.id }} .rt-steps__marker {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    font-size: 20px;
    font-weight: 700;
    line-height: 1;
    color: {{ section.settings.marker_text_color }};
    background: {{ section.settings.accent_color }};
    border-radius: {% if section.settings.marker_shape == 'circle' %}50%{% else %}10px{% endif %};
  }

  #shopify-section-{{ section.id }} .rt-steps__title {
    margin: 4px 0 0;
    font-size: 19px;
    line-height: 1.25;
    color: {{ section.settings.heading_color }};
  }

  #shopify-section-{{ section.id }} .rt-steps__body {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
  }

  #shopify-section-{{ section.id }} .rt-steps__note {
    max-width: 720px;
    margin: 28px auto 0;
    font-size: 14px;
    line-height: 1.5;
    text-align: center;
    opacity: 0.85;
  }

  #shopify-section-{{ section.id }} .rt-steps__note p {
    margin: 0;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .rt-steps {
      padding: {{ section.settings.padding_top }}px 32px {{ section.settings.padding_bottom }}px;
    }

    #shopify-section-{{ section.id }} .rt-steps__heading {
      font-size: {{ section.settings.heading_size }}px;
    }

    #shopify-section-{{ section.id }} .rt-steps__intro {
      margin-bottom: 44px;
    }

    #shopify-section-{{ section.id }} .rt-steps__grid {
      grid-template-columns: repeat({{ section.settings.columns }}, minmax(0, 1fr));
      gap: 20px;
    }
  }
{%- endstyle -%}

<div class="rt-steps">
  <div class="rt-steps__inner">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.text != blank -%}
      <div class="rt-steps__intro">
        {%- if section.settings.eyebrow != blank -%}
          <p class="rt-steps__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="rt-steps__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="rt-steps__text">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ol class="rt-steps__grid">
        {%- for block in section.blocks -%}
          <li class="rt-steps__card" {{ block.shopify_attributes }}>
            <span class="rt-steps__marker" aria-hidden="true">
              {%- if block.settings.icon != blank -%}
                {{ block.settings.icon }}
              {%- else -%}
                {{ forloop.index }}
              {%- endif -%}
            </span>
            {%- if block.settings.title != blank -%}
              <h3 class="rt-steps__title">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="rt-steps__body">{{ block.settings.text }}</p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}

    {%- if section.settings.note != blank -%}
      <div class="rt-steps__note">{{ section.settings.note }}</div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Royal Tofu Steps",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Comment ça marche"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "En 3 étapes simples"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "richtext",
      "id": "note",
      "label": "Note under the cards"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns on desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "marker_shape",
      "label": "Number / icon shape",
      "options": [
        { "value": "circle", "label": "Circle" },
        { "value": "square", "label": "Rounded square" }
      ],
      "default": "circle"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f4efe6"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_border",
      "label": "Card border",
      "default": "#eee7dc"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Headings",
      "default": "#2b211b"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#4b4038"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent (numbers, eyebrow)",
      "default": "#f2b705"
    },
    {
      "type": "color",
      "id": "marker_text_color",
      "label": "Number / icon color",
      "default": "#2b211b"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "section_width",
      "label": "Max width",
      "min": 800,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size (desktop)",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "mobile_heading_size",
      "label": "Heading size (mobile)",
      "min": 20,
      "max": 44,
      "step": 2,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding (desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding (desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Card",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon or emoji",
          "info": "Leave empty to show the card number."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Étape"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Royal Tofu Steps",
      "blocks": [
        { "type": "step", "settings": { "title": "Étape 1" } },
        { "type": "step", "settings": { "title": "Étape 2" } },
        { "type": "step", "settings": { "title": "Étape 3" } }
      ]
    }
  ]
}
{% endschema %}
