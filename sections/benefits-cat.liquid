      "label": "Pill border width",
      "default": 1
    },
    {
      "type": "range",
      "id": "pill_padding_vertical",
      "min": 4,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Desktop pill vertical padding",
      "default": 10
    },
    {
      "type": "range",
      "id": "pill_padding_horizontal",
      "min": 10,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Desktop pill horizontal padding",
      "default": 22
    },
    {
      "type": "range",
      "id": "mobile_pill_padding_vertical",
      "min": 4,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Mobile pill vertical padding",
      "default": 9
    },
    {
      "type": "range",
      "id": "mobile_pill_padding_horizontal",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
