{%- style -%}
  #BenefitsCat-{{ section.id }} {
    --bc-bg: {{ section.settings.background_color }};
    --bc-card-bg: {{ section.settings.card_background }};
    --bc-heading: {{ section.settings.heading_color }};
    --bc-text: {{ section.settings.text_color }};
    --bc-accent: {{ section.settings.accent_color }};
    --bc-border: {{ section.settings.card_border_color }};

    --bc-pill-text: {{ section.settings.pill_text_color }};
    --bc-pill-bg: {{ section.settings.pill_background_color }};
    --bc-pill-border: {{ section.settings.pill_border_color }};

    --bc-radius: {{ section.settings.card_radius }}px;

    width: 100%;
    background: var(--bc-bg);
    padding: {{ section.settings.desktop_padding_top }}px 20px {{ section.settings.desktop_padding_bottom }}px;
    overflow: hidden;
  }

  #BenefitsCat-{{ section.id }} * {
    box-sizing: border-box;
  }

  #BenefitsCat-{{ section.id }} .benefits-cat__inner {
    width: 100%;
    max-width: {{ section.settings.section_width }}px;
    margin: 0 auto;
  }

  #BenefitsCat-{{ section.id }} .benefits-cat__header {
    text-align: {{ section.settings.text_alignment }};
    max-width: 840px;
    margin: 0 auto {{ section.settings.header_spacing }}px;
  }

  #BenefitsCat-{{ section.id }} .benefits-cat__eyebrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    max-width: 100%;
    padding: {{ section.settings.pill_padding_vertical }}px {{ section.settings.pill_padding_horizontal }}px;
    margin-bottom: {{ section.settings.pill_margin_bottom }}px;
    color: var(--bc-pill-text);
    background: var(--bc-pill-bg);
    border: {{ section.settings.pill_border_width }}px solid var(--bc-pill-border);
    border-radius: 999px;
    font-size: {{ section.settings.eyebrow_size }}px;
    font-weight: {{ section.settings.pill_font_weight }};
    letter-spacing: {{ section.settings.pill_letter_spacing }}em;
    text-transform: uppercase;
    line-height: 1;
  }

  #BenefitsCat-{{ section.id }} .benefits-cat__heading {
    margin: 0;
    color: var(--bc-heading);
    font-size: {{ section.settings.desktop_heading_size }}px;
    line-height: {{ section.settings.heading_line_height | divided_by: 100.0 }};
    letter-spacing: -0.045em;
    font-weight: 900;
  }

  #BenefitsCat-{{ section.id }} .benefits-cat__highlight {
    color: var(--bc-accent);
    font-weight: 1000;
  }

  #BenefitsCat-{{ section.id }} .benefits-cat__subheading {
    margin: 18px auto 0;
    color: var(--bc-text);
    font-size: {{ section.settings.desktop_text_size }}px;
    line-height: 1.45;
    font-weight: 500;
    max-width: 720px;
  }

  #BenefitsCat-{{ section.id }} .benefits-cat__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.desktop_columns }}, minmax(0, 1fr));
    gap: {{ section.settings.card_gap }}px;
  }

  #BenefitsCat-{{ section.id }} .benefits-cat__card {
    position: relative;
    background: var(--bc-card-bg);
    border: 1px solid var(--bc-border);
    border-radius: var(--bc-radius);
    padding: {{ section.settings.card_padding }}px;
    min-height: {{ section.settings.card_min_height }}px;
    display: flex;
    flex-direction: column;
    align-items: {{ section.settings.card_alignment }};
    text-align: {{ section.settings.card_text_alignment }};
    box-shadow: {% if section.settings.enable_shadow %}0 14px 38px rgba(0, 0, 0, 0.08){% else %}none{% endif %};
    transition: transform 0.22s ease, box-shadow 0.22s ease;
  }

  #BenefitsCat-{{ section.id }} .benefits-cat__card:hover {
    transform: {% if section.settings.enable_hover %}translateY(-4px){% else %}none{% endif %};
    box-shadow: {% if section.settings.enable_hover %}0 18px 48px rgba(0, 0, 0, 0.11){% elsif section.settings.enable_shadow %}0 14px 38px rgba(0, 0, 0, 0.08){% else %}none{% endif %};
  }

  #BenefitsCat-{{ section.id }} .benefits-cat__icon-wrap {
    width: {{ section.settings.icon_box_size }}px;
    height: {{ section.settings.icon_box_size }}px;
    min-width: {{ section.settings.icon_box_size }}px;
    border-radius: 999px;
    background: {{ section.settings.icon_background }};
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    overflow: hidden;
  }

  #BenefitsCat-{{ section.id }} .benefits-cat__icon {
    font-size: {{ section.settings.icon_size }}px;
    line-height: 1;
    color: var(--bc-accent);
  }

  #BenefitsCat-{{ section.id }} .benefits-cat__icon-img {
    width: 62%;
    height: 62%;
    object-fit: contain;
    display: block;
  }

  #BenefitsCat-{{ section.id }} .benefits-cat__card-title {
    margin: 0 0 10px;
    color: var(--bc-heading);
    font-size: {{ section.settings.card_title_size }}px;
    line-height: 1.08;
    font-weight: 900;
    letter-spacing: -0.025em;
  }

  #BenefitsCat-{{ section.id }} .benefits-cat__card-text {
    margin: 0;
    color: var(--bc-text);
    font-size: {{ section.settings.card_text_size }}px;
    line-height: 1.45;
    font-weight: 500;
  }

  #BenefitsCat-{{ section.id }} .benefits-cat__button-wrap {
    display: flex;
    justify-content: center;
    margin-top: {{ section.settings.button_spacing }}px;
  }

  #BenefitsCat-{{ section.id }} .benefits-cat__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: {{ section.settings.button_height }}px;
    padding: 0 34px;
    border-radius: 999px;
    background: {{ section.settings.button_background }};
    color: {{ section.settings.button_text_color }};
    font-size: {{ section.settings.button_font_size }}px;
    font-weight: 900;
    text-decoration: none;
    line-height: 1;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  #BenefitsCat-{{ section.id }} .benefits-cat__button:hover {
    transform: translateY(-1px);
    opacity: 0.92;
  }

  @media screen and (max-width: 989px) {
    #BenefitsCat-{{ section.id }} .benefits-cat__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    #BenefitsCat-{{ section.id }} {
      padding: {{ section.settings.mobile_padding_top }}px {{ section.settings.mobile_side_padding }}px {{ section.settings.mobile_padding_bottom }}px;
    }

    #BenefitsCat-{{ section.id }} .benefits-cat__header {
      margin-bottom: {{ section.settings.mobile_header_spacing }}px;
    }

    #BenefitsCat-{{ section.id }} .benefits-cat__eyebrow {
      font-size: {{ section.settings.mobile_eyebrow_size }}px;
      padding: {{ section.settings.mobile_pill_padding_vertical }}px {{ section.settings.mobile_pill_padding_horizontal }}px;
      margin-bottom: {{ section.settings.mobile_pill_margin_bottom }}px;
    }

    #BenefitsCat-{{ section.id }} .benefits-cat__heading {
      font-size: {{ section.settings.mobile_heading_size }}px;
      line-height: {{ section.settings.mobile_heading_line_height | divided_by: 100.0 }};
    }

    #BenefitsCat-{{ section.id }} .benefits-cat__subheading {
      font-size: {{ section.settings.mobile_text_size }}px;
      margin-top: 14px;
    }

    #BenefitsCat-{{ section.id }} .benefits-cat__grid {
      grid-template-columns: repeat({{ section.settings.mobile_columns }}, minmax(0, 1fr));
      gap: {{ section.settings.mobile_card_gap }}px;
    }

    #BenefitsCat-{{ section.id }} .benefits-cat__card {
      padding: {{ section.settings.mobile_card_padding }}px;
      min-height: {{ section.settings.mobile_card_min_height }}px;
    }

    #BenefitsCat-{{ section.id }} .benefits-cat__icon-wrap {
      width: {{ section.settings.mobile_icon_box_size }}px;
      height: {{ section.settings.mobile_icon_box_size }}px;
      min-width: {{ section.settings.mobile_icon_box_size }}px;
      margin-bottom: 16px;
    }

    #BenefitsCat-{{ section.id }} .benefits-cat__icon {
      font-size: {{ section.settings.mobile_icon_size }}px;
    }

    #BenefitsCat-{{ section.id }} .benefits-cat__card-title {
      font-size: {{ section.settings.mobile_card_title_size }}px;
    }

    #BenefitsCat-{{ section.id }} .benefits-cat__card-text {
      font-size: {{ section.settings.mobile_card_text_size }}px;
    }

    #BenefitsCat-{{ section.id }} .benefits-cat__button-wrap {
      margin-top: {{ section.settings.mobile_button_spacing }}px;
    }

    #BenefitsCat-{{ section.id }} .benefits-cat__button {
      width: 100%;
      min-height: {{ section.settings.mobile_button_height }}px;
      font-size: {{ section.settings.mobile_button_font_size }}px;
    }
  }
{%- endstyle -%}

<section id="BenefitsCat-{{ section.id }}" class="benefits-cat-section">
  <div class="benefits-cat__inner">
    <div class="benefits-cat__header">
      {% if section.settings.eyebrow != blank %}
        <div class="benefits-cat__eyebrow">
          {{ section.settings.eyebrow }}
        </div>
      {% endif %}

      {% if section.settings.heading != blank %}
        {%- assign formatted_heading = section.settings.heading
          | escape
          | replace: '[[', '<span class="benefits-cat__highlight">'
          | replace: ']]', '</span>'
        -%}

        <h2 class="benefits-cat__heading">
          {{ formatted_heading | newline_to_br }}
        </h2>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <div class="benefits-cat__subheading">
          {{ section.settings.subheading }}
        </div>
      {% endif %}
    </div>

    <div class="benefits-cat__grid">
      {% for block in section.blocks %}
        <div class="benefits-cat__card" {{ block.shopify_attributes }}>
          <div class="benefits-cat__icon-wrap">
            {% if block.settings.icon_image != blank %}
              {{
                block.settings.icon_image
                | image_url: width: 180
                | image_tag:
                  loading: 'lazy',
                  class: 'benefits-cat__icon-img',
                  widths: '80, 120, 180',
                  sizes: '80px'
              }}
            {% else %}
              <span class="benefits-cat__icon">{{ block.settings.icon }}</span>
            {% endif %}
          </div>

          {% if block.settings.title != blank %}
            <h3 class="benefits-cat__card-title">
              {{ block.settings.title }}
            </h3>
          {% endif %}

          {% if block.settings.text != blank %}
            <p class="benefits-cat__card-text">
              {{ block.settings.text }}
            </p>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    {% if section.settings.button_label != blank %}
      <div class="benefits-cat__button-wrap">
        <a
          class="benefits-cat__button"
          {% if section.settings.button_link != blank %}
            href="{{ section.settings.button_link }}"
          {% else %}
            role="link" aria-disabled="true"
          {% endif %}
        >
          {{ section.settings.button_label }}
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Benefits Cat",
  "tag": "section",
  "class": "section-benefits-cat",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Pill text",
      "default": "Why Royal Tofu"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "A Better Litter Routine, [[From The First Scoop]]"
    },
    {
      "type": "paragraph",
      "content": "To highlight part of the heading, wrap it like this: [[highlighted text]]."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Designed for cleaner paws, fresher air, easier scooping, and a home that does not smell like a litter box."
    },
    {
      "type": "header",
      "content": "Pill badge"
    },
    {
      "type": "color",
      "id": "pill_text_color",
      "label": "Pill text color",
      "default": "#C99725"
    },
    {
      "type": "color",
      "id": "pill_background_color",
      "label": "Pill background color",
      "default": "#FFF7DF"
    },
    {
      "type": "color",
      "id": "pill_border_color",
      "label": "Pill border color",
      "default": "#FFC860"
    },
    {
